{
  "name": "videoai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:security": "vitest run tests/security",
    "test:portability": "vitest run tests/portability",
    "test:integration": "vitest run tests/integration",
    "lint": "eslint .",
    "db:migrate": "tsx infra/database/migrate.ts",
    "registry:sync": "tsx packages/skills/scripts/sync-registry.ts",
    "test:quality": "vitest run tests/quality",
    "dev:web": "pnpm --filter @videoai/web dev",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:schema": "vitest run tests/integration/schema.spec.ts",
    "db:rls": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f tests/security/rls.sql"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@videoai/api": "workspace:*",
    "@videoai/assets": "workspace:*",
    "@videoai/config": "workspace:*",
    "@videoai/contracts": "workspace:*",
    "@videoai/database": "workspace:*",
    "@videoai/director": "workspace:*",
    "@videoai/gpu-manager": "workspace:*",
    "@videoai/media": "workspace:*",
    "@videoai/models": "workspace:*",
    "@videoai/orchestrator": "workspace:*",
    "@videoai/qc": "workspace:*",
    "@videoai/quality": "workspace:*",
    "@videoai/render": "workspace:*",
    "@videoai/scene-bible": "workspace:*",
    "@videoai/skills": "workspace:*",
    "@videoai/storage": "workspace:*",
    "@videoai/telemetry": "workspace:*",
    "@videoai/timeline": "workspace:*",
    "@videoai/usage": "workspace:*",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fastify": "^5.12.1",
    "globals": "^17.11.0",
    "pg": "^8.23.0",
    "playwright": "^1.49.1",
    "prettier": "^3.9.6",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^2.1.8",
    "yaml": "^2.9.0"
  }
}

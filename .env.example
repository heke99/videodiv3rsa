# Copy to .env and fill in. Nothing here has a default in code: a missing value
# is a startup failure rather than a silent fallback (spec sections 58, 94).
# Never commit a filled-in .env; secrets come from a secret manager in
# production and this file only documents their shape.

NODE_ENV=development
LOG_LEVEL=info

# --- Branding and domain -----------------------------------------------------
# Moving to another domain is a change here plus DNS and auth callbacks.
PUBLIC_APP_URL=https://video.div3rsa.com
APP_NAME=Video AI
APP_DOMAIN=video.div3rsa.com
APP_LOGO_URL=/logo.svg
SUPPORT_EMAIL=support@example.com
LEGAL_ENTITY=
AUTH_CALLBACK_URL=https://video.div3rsa.com/auth/callback

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgres://postgres:password@localhost:5432/videoai
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Service role bypasses RLS. Backend services only; never ship to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Storage -----------------------------------------------------------------
# supabase | s3 | local
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=media
STORAGE_PUBLIC_BASE=
STORAGE_LOCAL_ROOT=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Compute -----------------------------------------------------------------
# manual | ssh | runpod. Business logic never learns which of these is in use.
GPU_PROVIDER=manual
GPU_IDLE_TIMEOUT_SECONDS=900
# At least 32 characters. Signs every backend-to-worker envelope.
GPU_GATEWAY_SIGNING_KEY=
GPU_ENVELOPE_TTL_SECONDS=120
MODEL_ROOT=/models
MODEL_REGISTRY_MODE=strict

# Only when GPU_PROVIDER=ssh
GPU_SSH_IDENTITY_FILE=
GPU_SSH_COMPOSE_FILE=/opt/videoai/compose.worker.yml
# Only when GPU_PROVIDER=runpod
GPU_PROVIDER_API_BASE=
GPU_PROVIDER_API_KEY=
GPU_WORKER_IMAGE=
GPU_PROFILE_INSTANCE_MAP={"GPU_PROFILE_ULTRA":"","GPU_PROFILE_HIGH":""}

# --- Orchestration -----------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=videoai

# --- Local reasoning and QC models -------------------------------------------
# Served by our own runtimes. No external LLM is required or permitted.
DIRECTOR_MODEL=
DIRECTOR_ENDPOINT=http://localhost:8002
QC_MODEL=
QC_ENDPOINT=http://localhost:8003

OTEL_EXPORTER_OTLP_ENDPOINT=
